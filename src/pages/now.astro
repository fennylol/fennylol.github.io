---
import Base from '../layouts/Base.astro';
import FormattedDate from '../components/FormattedDate.astro';

// A /now page (see https://nownownow.com). Update the date when you edit it.
const updated = new Date('2026-08-31');
---

<Base
  title="Now"
  description="What I'm focused on right now."
>
  <header class="stack-s page-head">
    <h1>Now</h1>
    <p class="muted">
      What I'm focused on at the moment. Last updated
      <FormattedDate date={updated} />.
    </p>
  </header>

  <div class="prose">
    <p>Replace this with a short, honest snapshot of your life right now:</p>
    <ul>
      <li><strong>Working on:</strong> …</li>
      <li><strong>Learning:</strong> …</li>
      <li><strong>Reading:</strong> …</li>
      <li><strong>Where:</strong> …</li>
    </ul>
    <p>
      This page is inspired by <a href="https://nownownow.com">nownownow.com</a>.
    </p>
  </div>
</Base>

<style>
  .page-head {
    padding-block: var(--space-l);
  }
</style>
