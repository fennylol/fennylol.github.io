---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostPreview from '../components/PostPreview.astro';
import { getProjects, getPosts } from '../lib/content';
import { site } from '../site.config';

const HIGHLIGHT_COUNT = 3;

// Favorites first (in their existing newest-first order), then fill any
// remaining slots with the next most recent non-favorites.
function highlights<T extends { data: { favorite: boolean } }>(items: T[]): T[] {
  const favorites = items.filter((i) => i.data.favorite);
  const rest = items.filter((i) => !i.data.favorite);
  return [...favorites, ...rest].slice(0, HIGHLIGHT_COUNT);
}

const projects = await getProjects();
const showcase = highlights(projects);

const allPosts = await getPosts();
const posts = highlights(allPosts);
---

<Base wide>
  <section class="hero stack-s">
    <h1 class="eyebrow">{site.title}</h1>
    {site.tagline && <h1>{site.tagline}</h1>}
    <h3 class="intro">
      (The "Joshua" is silent)
    </h3>
    <p class="muted intro">
      This is built to serve as a unified store for my projects, their explanations, link to my other profiles and my friends', and also a way to craft custom resumes.
      (It's not that useful to you, it can't make you a resume... but I still think it's pretty cool. Check it out!)
    </p>
  </section>

  {
    showcase.length > 0 && (
      <Section
        title="Selected projects"
        moreHref="/projects"
        moreLabel="All projects"
        id="favorites"
      >
        <div class="grid">
          {showcase.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </Section>
    )
  }

  {
    posts.length > 0 && (
      <Section title="From the write-ups" moreHref="/blog" moreLabel="All posts">
        <div class="stack">
          {posts.map((post) => (
            <PostPreview post={post} />
          ))}
        </div>
      </Section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-l);
  }
  .hero h1 {
    font-size: var(--size-step-3);
    max-width: 20ch;
  }
  .hero .eyebrow {
    /* Not capped at 20ch like a normal hero heading, so it stays on one
       line on desktop; it still wraps normally on phones. */
    max-width: none;
  }
  .intro {
    max-width: 55ch;
  }
  .grid {
    display: grid;
    gap: var(--space-m);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }
</style>
