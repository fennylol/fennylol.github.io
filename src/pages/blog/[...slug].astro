---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Post from '../../layouts/Post.astro';
import { getPosts } from '../../lib/content';

// getStaticPaths runs ONCE at build time and returns every page this
// [...slug] route should generate — one entry per blog post. Whatever you
// put in `props` is handed to the page below as `Astro.props`.
export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { data } = post;
const { Content } = await render(post);
---

<Post
  title={data.title}
  lede={data.summary}
  summary={data.summary}
  date={data.date}
  updated={data.updated}
  tags={data.tags}
  backHref="/blog"
  backLabel="All posts"
>
  <Content />
</Post>
