---
import Base from '../../layouts/Base.astro';
import ResumeBody from '../../components/resume/ResumeBody.astro';
import { site } from '../../site.config';
---

<Base title="Résumé" description={`Résumé of ${site.title}.`} wide>
  <div class="actions no-print">
    <button type="button" onclick="window.print()">Save as PDF</button>
    <a href="/resume/builder">Build a tailored résumé &rarr;</a>
    <a href="/#featured">See featured projects &rarr;</a>
  </div>

  <ResumeBody />
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-m);
    padding-block: var(--space-l);
    max-width: 48rem;
    margin-inline: auto;
  }
  .actions button {
    padding: var(--space-2xs) var(--space-s);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--color-surface);
    cursor: pointer;
  }
  .actions button:hover {
    border-color: var(--color-link);
  }
</style>
