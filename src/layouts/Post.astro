---
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagList from '../components/TagList.astro';

interface Props {
  title: string;
  /** Display-only second line under the title — a title extension (projects). */
  subtitle?: string;
  /** Descriptive lede under the title. Blog posts pass their summary here;
   *  rendered the same as `subtitle`, but the two are semantically distinct. */
  lede?: string;
  summary?: string;
  date: Date;
  updated?: Date;
  tags?: string[];
  /** Project lifecycle badge, e.g. "completed :3" — projects only. Shown in
   *  the site's accent color, same as the card's status badge. */
  status?: string;
  /** Back-link target, e.g. "/blog" or "/projects". */
  backHref: string;
  backLabel: string;
}
const {
  title,
  subtitle,
  lede,
  summary,
  date,
  updated,
  tags = [],
  status,
  backHref,
  backLabel,
} = Astro.props;
---

<Base title={title} description={summary} type="article">
  <article class="stack">
    <p class="back-link"><a href={backHref}>&larr; {backLabel}</a></p>
    <header class="stack-s">
      <h1>{title}</h1>
      {(subtitle ?? lede) && <p class="subtitle muted">{subtitle ?? lede}</p>}
      <p class="muted">
        <FormattedDate date={date} updated={updated} />
        {status && <span class="status">{status}</span>}
      </p>
      <TagList tags={tags} />
      <slot name="badges" />
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  /* A little breathing room below the sticky site header, which otherwise
     sits flush against this link at the top of the page. */
  .back-link {
    padding-top: var(--space-s);
  }
  .back-link a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-s);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--size-step--1);
  }
  .back-link a:hover {
    border-color: var(--color-link);
    color: var(--color-link);
  }
  header {
    padding-bottom: var(--space-m);
    /* Recolors the existing divider rather than adding a new element — ties
       every project/write-up page into the site's shifting accent color. */
    border-bottom: 1px solid var(--color-accent);
  }
  .subtitle {
    font-size: var(--size-step-1);
    line-height: 1.3;
  }
  /* Matches ProjectCard's status badge — same treatment, now also shown on
     the project's own page, not just its listing card. */
  .status {
    margin-left: var(--space-s);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85em;
    color: var(--color-accent);
  }
</style>
