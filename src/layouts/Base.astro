---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Use the wider column (listings, galleries). */
  wide?: boolean;
}
const { title, description, type, wide = false } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <BaseHead title={title} description={description} type={type} />
    {/* Resolve the theme before first paint so there's no light/dark flash.
        is:inline keeps it here, unbundled, running synchronously. */}
    <script is:inline>
      (() => {
        try {
          const t =
            localStorage.getItem('theme') ||
            (matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light');
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    {/* --color-accent (mauve by default) gets re-rolled to one of the nav
        hues on every full page load, never repeating the last one — this
        is what recolors "fenny", the favorite-project star, focus rings,
        and every other accent-colored bit of the site together. Runs here,
        pre-paint, so none of that flashes the default color first. */}
    <script is:inline>
      (() => {
        const NAV_COLOR_COUNT = 7;
        const STORAGE_KEY = 'accent-color-index';
        try {
          let last = Number(sessionStorage.getItem(STORAGE_KEY)) || null;
          const choices = Array.from({ length: NAV_COLOR_COUNT }, (_, i) => i + 1).filter(
            (n) => n !== last,
          );
          const n = choices[Math.floor(Math.random() * choices.length)];
          document.documentElement.style.setProperty(
            '--color-accent',
            `var(--color-nav-${n})`,
          );
          sessionStorage.setItem(STORAGE_KEY, String(n));
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" class={`wrap ${wide ? 'wrap--wide' : ''}`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
