---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  /** Use the wider column (listings, galleries). */
  wide?: boolean;
}
const { title, description, type, wide = false } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <BaseHead title={title} description={description} type={type} />
    {/* Resolve the theme before first paint so there's no light/dark flash.
        is:inline keeps it here, unbundled, running synchronously. */}
    <script is:inline>
      (() => {
        try {
          const t =
            localStorage.getItem('theme') ||
            (matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light');
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
    {/* --color-accent (mauve by default) gets re-rolled to one of the
        --color-accent-N hues on every full page load, never repeating the
        last one — this
        is what recolors "fenny", the favorite-project star, focus rings,
        and every other accent-colored bit of the site together. Runs here,
        pre-paint, so none of that flashes the default color first. */}
    <script is:inline>
      (() => {
        const ACCENT_COLOR_COUNT = 7;
        const STORAGE_KEY = 'accent-color-index';
        try {
          let last = Number(sessionStorage.getItem(STORAGE_KEY)) || null;
          const choices = Array.from({ length: ACCENT_COLOR_COUNT }, (_, i) => i + 1).filter(
            (n) => n !== last,
          );
          const n = choices[Math.floor(Math.random() * choices.length)];
          document.documentElement.style.setProperty(
            '--color-accent',
            `var(--color-accent-${n})`,
          );
          sessionStorage.setItem(STORAGE_KEY, String(n));
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main" class={`wrap ${wide ? 'wrap--wide' : ''}`}>
      <slot />
    </main>
    <Footer />
    {/* The favicon "f" takes this page's accent and background, so it
        matches "fenny" in the nav. Down here rather than with the accent
        script: an inline script at the end of <body> waits for the
        stylesheets, so the custom properties resolve to real colors. Same
        drawing as public/favicon.svg, which stays as the no-JS fallback. */}
    <script is:inline>
      (() => {
        const link = document.querySelector('link[rel="icon"]');
        const root = document.documentElement;
        if (!link) return;
        const paint = () => {
          const css = getComputedStyle(root);
          const bg = css.getPropertyValue('--color-bg').trim();
          const fg = css.getPropertyValue('--color-accent').trim();
          if (!bg || !fg) return;
          const svg =
            `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">` +
            `<rect width="32" height="32" rx="7" fill="${bg}"/>` +
            `<path d="M15 25V11.5a4 4 0 0 1 4-4h2M11 14h9" fill="none" stroke="${fg}" ` +
            `stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
          link.href = 'data:image/svg+xml,' + encodeURIComponent(svg);
        };
        paint();
        // The theme toggle flips data-theme; repaint so the tile follows.
        new MutationObserver(paint).observe(root, { attributeFilter: ['data-theme'] });
      })();
    </script>
  </body>
</html>
