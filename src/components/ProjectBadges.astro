---
import type { CollectionEntry } from 'astro:content';
import { externalAttrs } from '../lib/links';
import Badge from './Badge.astro';
import GenAIBadge from './GenAIBadge.astro';

/**
 * The row of labelled badges shown for a project: its links (live, source,
 * downloads) plus the GenAI disclosure. Shared by the project cards and the
 * project detail pages so the two can't drift apart.
 */
interface Props {
  project: CollectionEntry<'projects'>;
  /** Cards sit inside a stretched-link overlay and need a higher stack order. */
  raised?: boolean;
}
const { project, raised = false } = Astro.props;
const { data, id } = project;
const { downloads } = data;

// The downloads card on the project page only lists direct (same-origin)
// files — a remote link (e.g. an itch.io page) is nothing more than what
// the badge below already points at, so it'd just be a redundant box.
const hasDirectDownload = downloads.some((d) => d.href.startsWith('/'));

// One download → link straight at the file. Several with at least one
// direct file → send them to the project page's downloads card. Several
// but all remote (or none at all) → no card exists to send them to, so
// link the first if there is one.
const downloadHref =
  downloads.length === 1
    ? downloads[0].href
    : hasDirectDownload
      ? `/projects/${id}#downloads`
      : downloads[0]?.href;
// The `download` attribute only forces a save for same-origin files; on a
// cross-origin URL browsers ignore it and let the server's headers decide.
const forcesDownload =
  downloads.length === 1 && downloads[0].href.startsWith('/');

---

{
  (
    /* The GenAI badge is always present (the field is required), so the row
       always renders. */
    <div class:list={['badges', { raised }]}>
      {data.link && (
        <Badge tone="live" href={data.link} {...externalAttrs(data.link)}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            <polyline points="15 3 21 3 21 9" />
            <line x1="10" y1="14" x2="21" y2="3" />
          </svg>
          Live site
        </Badge>
      )}

      {data.source && (
        <Badge tone="source" href={data.source} {...externalAttrs(data.source)}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <polyline points="16 18 22 12 16 6" />
            <polyline points="8 6 2 12 8 18" />
          </svg>
          Open source
        </Badge>
      )}

      {downloads.length > 0 && (
        <Badge
          tone="download"
          href={downloadHref}
          download={forcesDownload ? true : undefined}
          {...externalAttrs(downloadHref)}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          {downloads.length > 1 ? 'Downloads' : 'Download'}
        </Badge>
      )}

      <GenAIBadge level={data.genai} />
    </div>
  )
}

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-2xs);
  }

  /* Inside a project card the stretched link covers everything; the real
     links have to sit above it to stay clickable. The badges are child
     components, hence :global. */
  .raised :global(a.badge) {
    position: relative;
    z-index: 2;
  }
</style>
