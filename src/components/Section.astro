---
// A titled page section with an optional "more →" link in the heading.
// The <slot /> below is where whatever you nest inside <Section>…</Section>
// gets rendered — it's Astro's equivalent of React's {children}.
interface Props {
  title: string;
  moreHref?: string;
  moreLabel?: string;
  /** Optional id for deep-linking, e.g. #featured. */
  id?: string;
}
const { title, moreHref, moreLabel = 'More', id } = Astro.props;
---

<section class="section stack" id={id}>
  <div class="section-head">
    <h2>{title}</h2>
    {moreHref && <a href={moreHref}>{moreLabel} &rarr;</a>}
  </div>
  <slot />
</section>

<style>
  .section + .section {
    margin-top: var(--space-2xl);
  }
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-s);
    border-bottom: var(--border);
    padding-bottom: var(--space-2xs);
  }
  .section-head a {
    font-size: var(--size-step--1);
  }
</style>
