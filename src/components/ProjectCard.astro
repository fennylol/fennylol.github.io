---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import TagList from './TagList.astro';
import ProjectBadges from './ProjectBadges.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const { data, id } = project;
---

<article class="card" data-tags={JSON.stringify(data.tags)}>
  <h3 class="card-title">
    {/* The whole card is clickable via this link's stretched ::after. */}
    <a class="card-link" href={`/projects/${id}`}>{data.title}</a>
    {data.favorite && <span class="badge" title="Favorite">★</span>}
  </h3>
  {data.subtitle && <p class="card-subtitle muted">{data.subtitle}</p>}
  <p class="summary">{data.summary}</p>
  <div class="meta muted">
    <FormattedDate date={data.date} />
    <span class="status">{data.status}</span>
    <TagList tags={data.tags} />
  </div>
  <ProjectBadges project={project} raised />
</article>

<style>
  .card {
    position: relative;
    border: var(--border);
    border-radius: var(--radius);
    padding: var(--space-m);
    background: var(--color-card);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    height: 100%;
    /* Set by the tag-filter script on /projects to dim non-matching cards;
       untouched (defaults to 1) everywhere else. */
    opacity: var(--match-brightness, 1);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease,
      opacity 0.2s ease;
  }

  /*
   * "Stretched link": the title's <a> grows an invisible overlay covering the
   * whole card, so clicking anywhere follows it. Keeps the markup to ONE real
   * link — no nested anchors, screen readers still announce the title as the
   * destination, and middle-click / open-in-new-tab work normally.
   * Trade-off: the overlay makes card text non-selectable.
   */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    /* Required. .card is a flex container, and flex items paint atomically
       like inline-blocks — without a z-index this overlay would be painted
       as part of .card-title and end up UNDERNEATH .summary/.meta/.links,
       which would then swallow the clicks. */
    z-index: 1;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-link);
    transform: translateY(-2px);
  }
  .card:hover .card-title a,
  .card:focus-within .card-title a {
    color: var(--color-link);
  }

  .card-title {
    font-size: var(--size-step-1);
    display: flex;
    align-items: baseline;
    gap: var(--space-2xs);
  }
  .card-title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .card-title a:hover {
    text-decoration: underline;
  }
  .badge {
    color: var(--color-accent);
    font-size: 0.8em;
    /* Above the overlay so its title tooltip still appears on hover. */
    position: relative;
    z-index: 2;
  }
  .card-subtitle {
    font-size: var(--size-step--1);
    line-height: 1.35;
    margin-top: calc(-1 * var(--space-3xs));
  }
  .summary {
    flex: 1;
  }
  .meta {
    font-size: var(--size-step--1);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
  }
  /* Reach into TagList/Tag's own markup to size and pack down just the
     card's tag row — other TagList usages (blog header, the /projects
     filter) keep their own sizing. */
  .meta :global(.tag-list) {
    font-size: 0.8em;
    row-gap: 2px;
  }
  .status {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.85em;
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: border-color 0.15s ease;
    }
    .card:hover,
    .card:focus-within {
      transform: none;
    }
  }
</style>
