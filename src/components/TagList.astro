---
import Tag from './Tag.astro';

interface Props {
  tags: string[];
  /** Optional lead-in text, e.g. "Tags:" */
  label?: string;
  /** Render tags as toggle buttons (project-listing tag filter). */
  interactive?: boolean;
}
const { tags, label, interactive = false } = Astro.props;
---

{
  tags.length > 0 && (
    <span
      class="tag-list"
      data-tag-filter={interactive ? true : undefined}
      aria-label={interactive ? 'Filter projects by tag' : undefined}
    >
      {label && <span>{label}</span>}
      {tags.map((tag) => (
        <Tag name={tag} interactive={interactive} />
      ))}
    </span>
  )
}

<style>
  .tag-list {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    font-size: var(--size-step--1);
    color: var(--color-muted);
  }
</style>
