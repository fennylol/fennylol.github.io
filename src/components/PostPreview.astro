---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { data, id } = post;
---

<article class="card">
  <h3 class="card-title">
    {/* The whole card is clickable via this link's stretched ::after. */}
    <a class="card-link" href={`/blog/${id}`}>{data.title}</a>
  </h3>
  <p class="summary">{data.summary}</p>
  <div class="meta muted">
    <FormattedDate date={data.date} />
  </div>
</article>

<style>
  /*
   * Mirrors ProjectCard's card treatment (border, radius, hover lift,
   * stretched link) so the two listings read as the same visual system.
   * Trimmed down: no status/tags/badges, since posts don't carry them.
   */
  .card {
    position: relative;
    border: var(--border);
    border-radius: var(--radius);
    padding: var(--space-m);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  /* Same "stretched link" trick as ProjectCard: one real link, whole card
     clickable, no nested anchors. */
  .card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    z-index: 1;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-link);
    transform: translateY(-2px);
  }
  .card:hover .card-title a,
  .card:focus-within .card-title a {
    color: var(--color-link);
  }

  .card-title {
    font-size: var(--size-step-1);
  }
  .card-title a {
    color: var(--color-text);
    text-decoration: none;
  }
  .card-title a:hover {
    text-decoration: underline;
  }
  .summary {
    color: var(--color-muted);
  }
  .meta {
    font-size: var(--size-step--1);
  }
  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: border-color 0.15s ease;
    }
    .card:hover,
    .card:focus-within {
      transform: none;
    }
  }
</style>
