---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="resume-section">
  <h2>{title}</h2>
  <slot />
</section>

<style>
  /* --resume-scale is set on .resume by the fit-to-page script before
     printing; 1 everywhere else. */
  .resume-section {
    margin-top: calc(var(--space-xl) * var(--resume-scale, 1));
  }
  .resume-section h2 {
    font-size: 1.25em;
    padding-bottom: var(--space-3xs);
    margin-bottom: calc(var(--space-m) * var(--resume-scale, 1));
    border-bottom: 1px solid var(--color-accent);
  }

  @media print {
    .resume-section {
      margin-top: calc(var(--space-l) * var(--resume-scale, 1));
    }
    .resume-section h2 {
      border-color: #000;
    }
  }
</style>
