---
import { nav, site } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

// Highlight the current section (match on the first path segment).
const here = '/' + (Astro.url.pathname.split('/').filter(Boolean)[0] ?? '');
const isCurrent = (href: string) =>
  href === '/' ? Astro.url.pathname === '/' : href === here;

---

<header class="site-header">
  <div class="wrap wrap--wide bar">
    <a href="/" class="brand">
      {site.firstName} <span class="nickname">{site.highlight}</span> {site.lastName}
    </a>
    <div class="bar-end">
      <nav aria-label="Primary">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: var(--border);
    background: var(--color-bg);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-s);
  }
  .bar-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
  }
  .brand {
    font-weight: 700;
    font-size: var(--size-step-1);
    color: var(--color-text);
    text-decoration: none;
  }
  nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  nav a {
    --tone: var(--color-link);
    color: var(--color-muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--tone);
  }
  nav a[aria-current='page'] {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* One catppuccin hue per tab, cycled by position. Only hover/current pull
     from --tone (above), so the ribbon stays muted at rest. */
  nav li:nth-child(7n + 1) a { --tone: var(--color-nav-1); }
  nav li:nth-child(7n + 2) a { --tone: var(--color-nav-2); }
  nav li:nth-child(7n + 3) a { --tone: var(--color-nav-3); }
  nav li:nth-child(7n + 4) a { --tone: var(--color-nav-4); }
  nav li:nth-child(7n + 5) a { --tone: var(--color-nav-5); }
  nav li:nth-child(7n + 6) a { --tone: var(--color-nav-6); }
  nav li:nth-child(7n + 7) a { --tone: var(--color-nav-7); }

  /* Rides the site's accent color, which Base.astro re-rolls to a random
     nav hue on every page load — so "fenny" changes color along with every
     other accent-colored element on the page, not on its own. */
  .nickname {
    color: var(--color-accent);
  }
</style>
