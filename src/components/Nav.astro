---
import { nav, site } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

// Highlight the current section (match on the first path segment).
const here = '/' + (Astro.url.pathname.split('/').filter(Boolean)[0] ?? '');
const isCurrent = (href: string) =>
  href === '/' ? Astro.url.pathname === '/' : href === here;

---

<header class="site-header">
  <div class="wrap wrap--wide bar">
    <a href="/" class="brand">
      {site.firstName} <span class="nickname">{site.highlight}</span> {site.lastName}
    </a>
    <div class="bar-end">
      <nav aria-label="Primary">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: var(--border);
    background: var(--color-bg);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding-block: var(--space-s);
  }
  .bar-end {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
  }
  .brand {
    font-weight: 700;
    font-size: var(--size-step-1);
    color: var(--color-text);
    text-decoration: none;
  }
  nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
  nav a {
    --tone: var(--color-link);
    color: var(--color-muted);
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--tone);
  }
  nav a[aria-current='page'] {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* One catppuccin hue per tab, cycled by position. Only hover/current pull
     from --tone (above), so the ribbon stays muted at rest. Six tabs, so a
     six-step cycle over accent-1..6. Pink (accent-7) is left out here but
     stays in the pool Base.astro rolls the site accent from. */
  nav li:nth-child(6n + 1) a { --tone: var(--color-accent-1); }
  nav li:nth-child(6n + 2) a { --tone: var(--color-accent-2); }
  nav li:nth-child(6n + 3) a { --tone: var(--color-accent-3); }
  nav li:nth-child(6n + 4) a { --tone: var(--color-accent-4); }
  nav li:nth-child(6n + 5) a { --tone: var(--color-accent-5); }
  nav li:nth-child(6n + 6) a { --tone: var(--color-accent-6); }

  /* Rides the site's accent color, which Base.astro re-rolls to a random
     nav hue on every page load — so "fenny" changes color along with every
     other accent-colored element on the page, not on its own. */
  .nickname {
    color: var(--color-accent);
  }

  /* Anything narrower than a single-line header (name + six tabs + toggle
     needs roughly 50rem): a fixed two-row layout instead of free-wrapping.
     Row one is the name and the theme toggle; row two is the tab ribbon,
     which scrolls sideways if it ever overflows rather than breaking onto
     a third line. `display: contents` lets the toggle and nav sit directly
     in the grid without changing the markup. */
  @media (max-width: 52rem) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      row-gap: var(--space-2xs);
    }
    .bar-end {
      display: contents;
    }
    .brand {
      grid-area: 1 / 1;
    }
    /* Pin the toggle next to the name. Left to auto-placement it lands on
       a row of its own below the nav, because the nav's full-width span
       moves the placement cursor past row one before the toggle is placed. */
    .bar-end :global(#theme-toggle) {
      grid-area: 1 / 2;
      justify-self: end;
    }
    nav {
      grid-area: 2 / 1 / 3 / -1;
      /* Bleed to the viewport edge so scrolled tabs aren't clipped at the
         wrap's padding, then pad back in so the first tab still aligns. */
      margin-inline: calc(-1 * var(--space-s));
      padding-inline: var(--space-s);
      overflow-x: auto;
      scrollbar-width: none;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    nav ul {
      flex-wrap: nowrap;
    }
    nav a {
      white-space: nowrap;
    }
  }
  /* Phone widths: shrink the ribbon so all six tabs fit without scrolling. */
  @media (max-width: 30rem) {
    nav ul {
      gap: var(--space-xs);
      font-size: var(--size-step--1);
    }
  }
</style>
